# New variables for real push notifications (web push + email).
# Everything else the app already needs (DATABASE_URL, DIRECT_DATABASE_URL,
# Clerk keys, etc.) is configured separately in Vercel / your local .env and
# is unaffected by this feature.

# --- Web Push (VAPID) ---
# Generate once with: npx web-push generate-vapid-keys
# Rotating the private key invalidates every subscription already stored,
# so everyone would need to click "Enable notifications" again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services may use to reach you about this app.
VAPID_SUBJECT=mailto:admin@alaninternationialschool.com

# --- Email (Resend) ---
# Get a key at https://resend.com (free tier is enough to start).
RESEND_API_KEY=
# Leave unset to send from Resend's shared sandbox address (only deliverable
# to your own Resend account's verified email - fine for testing). Once you
# verify a sending domain in Resend, set this to something like:
#   EMAIL_FROM="Alan International School <notifications@alaninternationialschool.com>"
EMAIL_FROM=

# --- Duty roster reminders ---
# Shared secret for /api/cron/duty-reminders (the endpoint refuses every request
# when this is unset). Generate one with: openssl rand -hex 32
# Set the SAME value as the CRON_SECRET repository secret in GitHub (used by
# .github/workflows/duty-reminders.yml together with DUTY_APP_URL).
CRON_SECRET=
# Lead time, school time zone and days off are configured in the admin page
# (Duty Roster -> Settings), not through env vars.
